// Prisma schema — works against Supabase's Postgres (or any Postgres instance).
// Run `npx prisma migrate dev` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- AUTH / ADMIN ----------

enum AdminRole {
  OWNER
  STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(STAFF)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

// ---------- CATALOG ----------

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String
  priceCents  Int
  images      ProductImage[]
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  stock       Int          @default(0)
  isActive    Boolean      @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)
}

model InventoryMovement {
  id        String   @id @default(cuid())
  productId String
  delta     Int
  reason    String
  createdAt DateTime @default(now())
}

// ---------- CUSTOMERS ----------

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String
  lastName  String
  phone     String
  orders    Order[]
  createdAt DateTime @default(now())
}

// ---------- ORDERS ----------

enum OrderStatus {
  NEW
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryMethod {
  INPOST_LOCKER
  INPOST_COURIER
}

model Order {
  id                String         @id @default(cuid())
  orderNumber       String         @unique
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id])

  items             OrderItem[]

  subtotalCents     Int
  discountCents     Int            @default(0)
  shippingCents     Int
  totalCents        Int

  discountCodeId    String?
  discountCode      DiscountCode?  @relation(fields: [discountCodeId], references: [id])

  deliveryMethod    DeliveryMethod
  inpostLockerCode  String?
  shippingAddress   Json?

  status            OrderStatus    @default(NEW)
  paymentStatus     PaymentStatus  @default(PENDING)

  payment           Payment?
  shipment          Shipment?
  discountUsage     DiscountUsage?

  trafficSource     String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int
}

// ---------- PAYMENTS (Stripe) ----------

model Payment {
  id                      String        @id @default(cuid())
  orderId                 String        @unique
  order                   Order         @relation(fields: [orderId], references: [id])
  provider                String        @default("stripe")
  stripePaymentIntentId   String?       @unique
  stripeCheckoutSessionId String?       @unique
  status                  PaymentStatus @default(PENDING)
  method                  String?
  amountCents             Int
  currency                String        @default("pln")
  rawWebhookPayload       Json?
  createdAt               DateTime      @default(now())
  confirmedAt             DateTime?
}

// ---------- DISCOUNTS ----------

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
}

model DiscountCode {
  id              String         @id @default(cuid())
  code            String         @unique
  type            DiscountType
  value           Int
  startsAt        DateTime?
  endsAt          DateTime?
  maxUses         Int?
  minOrderCents   Int?
  isActive        Boolean        @default(true)
  usages          DiscountUsage[]
  orders          Order[]
  createdAt       DateTime       @default(now())
}

model DiscountUsage {
  id             String       @id @default(cuid())
  discountCodeId String
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id])
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id])
  discountCents  Int
  createdAt      DateTime     @default(now())
}

// ---------- SHIPPING (InPost) ----------

enum ShipmentStatus {
  NOT_CREATED
  CREATED
  CONFIRMED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String         @unique
  order             Order          @relation(fields: [orderId], references: [id])
  provider          String         @default("inpost")
  inpostShipmentId  String?
  trackingNumber    String?
  labelUrl          String?
  status            ShipmentStatus @default(NOT_CREATED)
  lastSyncedAt      DateTime?
  createdAt         DateTime       @default(now())
}
