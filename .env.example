# =============================================================
# ZODARA PARFUMS — zmienne środowiskowe
# Skopiuj ten plik na .env.local i uzupełnij wartości.
# NIGDY nie wpisuj prawdziwych sekretów do kodu źródłowego.
# =============================================================

# --- Aplikacja ---
# Publiczny adres sklepu (lokalnie i na produkcji)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Baza danych (Supabase / PostgreSQL) ---postgresql://postgres.qvyustvoohuxrgqcofdu:Kukurydza123@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Connection string poolera transakcyjnego (port 6543), np.:
# postgresql://postgres.<ref>:<haslo>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Połącz: uruchom treść supabase/schema.sql w SQL Editorze Supabase.
# Bez tej zmiennej sklep działa na danych z lib/config/product.ts,
# a panel admina pokazuje instrukcję podłączenia bazy.
DATABASE_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Sekret webhooka: Stripe Dashboard → Developers → Webhooks → {whsec_...}
# Webhook URL do skonfigurowania: {NEXT_PUBLIC_APP_URL}/api/checkout/webhook
# Eventy: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=

# --- Panel administracyjny ---
# E-mail logowania właścicielki do /admin (opcjonalny — bez niego logowanie samym hasłem)
ADMIN_EMAIL=
# Hasło logowania do /admin (wymagane, aby wejść do panelu)
ADMIN_PASSWORD=
# Losowy sekret sesji admina, np.: openssl rand -base64 32
AUTH_SECRET=

# --- Formularz kontaktowy ---
# URL endpointu, na który trafiają wiadomości (np. Formspree: https://formspree.io/f/xxxxxx).
# Jeśli pusty, formularz zwraca czytelny komunikat o braku konfiguracji (503),
# a nie udawanego sukcesu.
CONTACT_WEBHOOK_URL=

# --- Newsletter / Resend ---
# Klucz API Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Zweryfikowany adres nadawcy (np. newsletter@twojadomena.pl)
NOTIFICATIONS_FROM_EMAIL=
